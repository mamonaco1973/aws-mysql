metry x="1284" y="744" width="52" height="52" as="geometry"/></mxCell><mxCell id="op3_t" value="&lt;b style=&quot;font-size:22px&quot;&gt;RDS  ·  Promote&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#5B6B82&quot;&gt;replica detaches into its own database&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#5B6B82&quot;&gt;replication never resumes&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#5B6B82&quot;&gt;one-way — there is no un-promote&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#1A2B4A;" vertex="1" parent="1"><mxGeometry x="1348" y="690" width="456" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>