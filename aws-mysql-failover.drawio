"" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#336791;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="680" width="560" height="180" as="geometry"/></mxCell><mxCell id="op1_i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23336791%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M8%203%204%207l4%204%22%2F%3E%3Cpath%20d%3D%22M4%207h16%22%2F%3E%3Cpath%20d%3D%22m16%2021%204-4-4-4%22%2F%3E%3Cpath%20d%3D%22M20%2017H4%22%2F%3E%3C%2Fsvg%3E" vertex="1" parent="1"><mxGeometry x="124" y="744" width="52" height="52" as="geometry"/></mxCell><mxCell id="op1_t" value="&lt;b style=&quot;font-size:22px&quot;&gt;Aurora  ·  Failover&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#5B6B82&quot;&gt;reader and writer trade places&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#5B6B82&quot;&gt;replication never stops&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#5B6B82&quot;&gt;reversible — do it again to swap back&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#1A2B4A;" vertex="1" parent="1"><mxGeometry x="188" y="690" width="456" height="160" as="geometry"/></mxCell><mxCell id="op2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B5732E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="680" width="520" height="180" as="geometry"/></mxCell><mxCell id="op2_i" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalAlign=middle;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20f